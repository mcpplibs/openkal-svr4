# THE ROW AS THIS REPOSITORY'S CHECKS BUILD IT, from working trees: this
# implementation as the `kernel-abi' layer, and the C library and the C++
# run-time by their trees, so that a change spanning them is examined as
# written (tools/row.sh fills the paths in). The row a project names is
# openkal-platform's; this file follows it and is not a second definition
# to select.
[package]
name    = "openkal-svr4-row"
version = "0.0.0"

[platform]
toolchain = "llvm@23.1.3"

[[platform.system]]
name = "svr4"

[[platform.define]]
triple       = "i686-svr4-musl"
clang-triple = "i386-unknown-none-elf"
family       = "unix"
data-model   = "ilp32"
execution    = "svr4"
tier         = "preview"
march        = "i486"
flags        = ["-femulated-tls", "-fasynchronous-unwind-tables", "-mstack-alignment=16", "-ffunction-sections", "-fdata-sections"]

[[platform.provider]]
name   = "svr4"
serves = ["i686-svr4-musl"]
base   = "none"
hosted = true
layers = { "kernel-abi" = { path = "@SVR4@", features = ["standalone"] }, compiler-runtime = { path = "@RUNTIME@" }, "c++-abi" = { path = "@RUNTIME@" }, c-abi = { path = "@MUSL@", default-features = false, features = ["posix", "malloc-mallocng"] } }
# The program headers are stated (svr4.ld, as openkal-platform 0.30.1 states them): the kernel of
# Release 4.0 kills a static program that has PT_PHDR.
link   = { driver = "lld", script = "svr4.ld", flags = ["-static", "-z", "norelro", "--gc-sections", "--eh-frame-hdr"] }
runner = { cmd = ["unshare", "-Ur", "@IBCS@", "{}"], host = "any", hosts = ["linux-x86_64"] }
